        // Contact
        section#contact.page-section
            .container
                .text-center
                    h2.section-heading.text-uppercase Contact Us
                    h3.section-subheading.text-muted Have a project in mind? Get in touch with us today.
                
                // * * * * * * * * * * * * * * *
                // * * SB Forms Contact Form * *
                // * * * * * * * * * * * * * * *

                // This form is pre-integrated with SB Forms.
                // To make this form functional, sign up at
                // https://startbootstrap.com/solution/contact-forms
                // to get an API token!

                form#contactForm(
                    action='https://formspree.io/f/mjybjozo',
                    method='POST')
                    .row.align-items-stretch.mb-5
                        .col-md-6
                            .form-group

                                // Name input
                                input#name.form-control(
                                    type='text',
                                    name='name',
                                    placeholder='Your Name *',
                                    required
                                )
                            .form-group

                                // Email address input
                                input#email.form-control(
                                    type='email',
                                    name='email',
                                    placeholder='Your Email *',
                                    required
                                )
                               
                            .form-group.mb-md-0

                                // Phone number input
                                input#phone.form-control(
                                    type='tel',
                                    name='phone',
                                    placeholder='Your Phone *',
                                    required
                                )

                        .col-md-6
                            .form-group.form-group-textarea.mb-md-0

                                // Message input
                                textarea#message.form-control(
                                    name='message',
                                    placeholder='Your Message *',
                                    required
                                )
                                


                    // Submit Button
                    .text-center
                    button#submitButton.btn.btn-primary.btn-xl.text-uppercase(
                    type='submit'
                    ) Send Message
