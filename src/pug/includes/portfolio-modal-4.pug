// Portfolio item 4 modal popup
#portfolioModal4.portfolio-modal.modal.fade(tabindex='-1', role='dialog', aria-hidden='true')
    .modal-dialog
        .modal-content
            .close-modal(data-bs-dismiss='modal')
                img(src='assets/img/close-icon.svg', alt='Close modal')
            .container
                .row.justify-content-center
                    .col-lg-8
                        .modal-body
                            // Project details
                            h2.text-uppercase Impact Window Installation
                            p.item-intro.text-muted Modern and High Quality.
                            img.img-fluid.d-block.mx-auto(src='assets/img/portfolio/4.jpg', alt='...')
                            p This project was part of my personal ventures. We completely remodeled the property to prepare it for the market. One of the key features highlighted in this project is the installation of impact windows, which completely transformed the home’s facade, giving it a modern and sophisticated appearance. More importantly, the high-quality glass provides excellent resistance and protection, which is especially important for Florida homeowners during hurricane season. The complete remodeling also included the bathrooms, flooring, doors, and interior and exterior painting, preparing the property for the Margate, Florida real estate market.
                            
                            ul.list-inline
                                li
                                    strong Client:
                                    | Luis Rodriguez & Tatiana Montiel
                                li
                                    strong Category:
                                    | Impact Window Installation & Complete Remodeling
                            button.btn.btn-primary.btn-xl.text-uppercase(data-bs-dismiss='modal', type='button')
                                i.fas.fa-xmark.me-1
                                | Close Project