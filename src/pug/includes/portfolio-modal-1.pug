// Portfolio item 1 modal popup
#portfolioModal1.portfolio-modal.modal.fade(tabindex='-1', role='dialog', aria-hidden='true')
    .modal-dialog
        .modal-content
            .close-modal(data-bs-dismiss='modal')
                img(src='assets/img/close-icon.svg', alt='Close modal')
            .container
                .row.justify-content-center
                    .col-lg-8
                        .modal-body
                            // Project details
                            h2.text-uppercase Modern Kitchen
                            p.item-intro.text-muted Complete kitchen remodeling.
                            img.img-fluid.d-block.mx-auto(src='assets/img/portfolio/1.jpg', alt='...')
                            p This was an entire remodeling project, including the bathrooms, floors, walls, doors, lighting, and paint. However, we want to highlight the kitchen transformation. The kitchen was designed to the owner’s taste, featuring a modern style and high-quality materials. It includes 100% wood, custom-made cabinets, Spanish porcelain flooring, and modern LED lighting.
                            ul.list-inline
                                li
                                    strong Client:
                                    | Jose & Javier Sorte
                                li
                                    strong Category:
                                    | Complete remodeling
                            button.btn.btn-primary.btn-xl.text-uppercase(data-bs-dismiss='modal', type='button')
                                i.fas.fa-xmark.me-1
                                | Close Project